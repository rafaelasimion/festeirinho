<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1u1tf5n" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:collaboration id="Collaboration_0yw1uuu">
    <bpmn:participant id="Participant_1d0kiqm" name="TRIAGEM" processRef="Process_16skc4c" />
    <bpmn:participant id="Participant_0y968zk" name="PAGAMENTO" processRef="Process_05van0b" />
    <bpmn:participant id="Participant_0283hn5" name="EXECUÇÃO DO SERVIÇO" processRef="Process_0s1jwxf" />
    <bpmn:participant id="Participant_1rp4qhl" name="CANCELAMENTO" processRef="Process_0n7eaps" />
    <bpmn:messageFlow id="Flow_0rkk97o" sourceRef="Event_0w12m5c" targetRef="Event_0hmx6ms" />
    <bpmn:messageFlow id="Flow_08v9hh4" sourceRef="Event_00qk1hd" targetRef="Event_1ao5yjx" />
    <bpmn:messageFlow id="Flow_03dzqii" sourceRef="Event_1refo28" targetRef="Event_1rld79c" />
    <bpmn:messageFlow id="Flow_0o7ocat" sourceRef="Event_1rt9m6p" targetRef="Event_1rld79c" />
    <bpmn:messageFlow id="Flow_1ujrgq0" sourceRef="Event_04ml9hq" targetRef="Event_1rld79c" />
    <bpmn:textAnnotation id="TextAnnotation_10l4l2j">
      <bpmn:text>análise de detalhes que o cliente enviou na hora da solicitação</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_11qhurk">
      <bpmn:text>Fornecedor seleciona o motivo:

- Agenda indisponível;
- Fora da área;
- Inviabilidade técnica/operacional/logística;
- Outro motivo.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1qcxkpm">
      <bpmn:text>Gera o pagamento no valor final calculado e retém a comissão no repasse ao fornecedor (RN027) e grava as faixas de multa vigentes, que passam a valer para o cancelamento e para o comprovante (RN050, RF058).

A opção de boleto só é exibida quando faltarem ao menos 5 dias (parametrizável) para o evento, em razão do prazo de compensação bancária (RN012)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0aanavz">
      <bpmn:text>Cancelamento poderá ser solicitado pelo cliente ou fornecedor em caso de imprevistos, mediante justificativa e aplicação das regras da plataforma.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_02e97c4">
      <bpmn:text>data-limite conforme forma de pagamento: 24h da geração (Pix/cartão) ou vencimento do boleto — nunca além de 24h antes do evento (RN024)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1mz5jk2">
      <bpmn:text>cliente recebe "seu pagamento foi confirmado", fornecedor recebe "sua agenda foi confirmada para tal data"</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1xfv3pb">
      <bpmn:text>cliente e fornecedor recebem mensagem sobre o cancelamento</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0z2gvsr">
      <bpmn:text>cliente e fornecedor recebem mensagem sobre o cancelamento</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0kod51t">
      <bpmn:text>cliente recebe notificação de expiração</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0u4sgkr">
      <bpmn:text>cliente recebe notificação de recusa</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0o364nu">
      <bpmn:text>a aprovação confirma o valor final calculado e gravado no envio (preço base × duração, × número de convidados ou valor fixo) e gera o pagamento; não há negociação de valor (RN029)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1pfgxv9">
      <bpmn:text>o chat da solicitação fica disponível até o registro da conclusão ou o cancelamento, para alinhamento operacional da execução — horário de montagem, retirada de materiais, acesso ao local (RN022)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_09fnjan">
      <bpmn:text>a aprovação habilita o canal de chat da solicitação, disponível até o registro da conclusão ou o cancelamento, para alinhamento operacional da execução — horário de montagem, retirada de materiais, acesso ao local (RN022)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_09ag3na" associationDirection="None" sourceRef="Event_0uhzyno" targetRef="TextAnnotation_0u4sgkr" />
    <bpmn:association id="Association_0w55lvi" associationDirection="None" sourceRef="Event_0hgia5d" targetRef="TextAnnotation_0kod51t" />
    <bpmn:association id="Association_1n17bg8" associationDirection="None" sourceRef="Event_0w12m5c" targetRef="TextAnnotation_09fnjan" />
    <bpmn:association id="Association_16csqro" associationDirection="None" sourceRef="Event_0w12m5c" targetRef="TextAnnotation_0o364nu" />
    <bpmn:association id="Association_015stbl" associationDirection="None" sourceRef="Activity_0rlcz6j" targetRef="TextAnnotation_11qhurk" />
    <bpmn:association id="Association_1f9p3ju" associationDirection="None" sourceRef="TextAnnotation_10l4l2j" targetRef="Activity_0c25abc" />
    <bpmn:textAnnotation id="TextAnnotation_098plu0">
      <bpmn:text>Os eventos de mensagem representados nos diagramas materializam-se como notificações registradas na central de notificações do usuário destinatário (RN065, RF064-B).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0yu35mt" associationDirection="None" sourceRef="Event_0tlll29" targetRef="TextAnnotation_02e97c4" />
    <bpmn:association id="Association_1vjp56i" associationDirection="None" sourceRef="Event_115x8ti" targetRef="TextAnnotation_0z2gvsr" />
    <bpmn:association id="Association_1aqjbhk" associationDirection="None" sourceRef="TextAnnotation_1qcxkpm" targetRef="Event_0hmx6ms" />
    <bpmn:association id="Association_1nghxbi" associationDirection="None" sourceRef="Event_00qk1hd" targetRef="TextAnnotation_1mz5jk2" />
    <bpmn:association id="Association_0he34zl" associationDirection="None" sourceRef="Event_1qgozud" targetRef="TextAnnotation_1xfv3pb" />
    <bpmn:textAnnotation id="TextAnnotation_11gyyco">
      <bpmn:text>A antecedência exigida no envio é a do serviço ou o mínimo vigente da plataforma, o que for maior. O mínimo cobre o prazo de resposta do fornecedor (48h) + o prazo de pagamento do cliente (24h) + as 24h que antecedem o evento: 4 dias com os valores padrão (RN046).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1q8s9gq" associationDirection="None" sourceRef="Activity_1mci1wt" targetRef="TextAnnotation_1pfgxv9" />
    <bpmn:association id="Association_13gspk2" associationDirection="None" sourceRef="TextAnnotation_0aanavz" targetRef="Event_1rld79c" />
    <bpmn:textAnnotation id="TextAnnotation_1g4zkag">
      <bpmn:text>data de confirmação = data da análise; a carência do repasse inicia aqui (RN056)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1kwi7ty" associationDirection="None" sourceRef="Flow_1q3qn0k" targetRef="TextAnnotation_1g4zkag" />
    <bpmn:textAnnotation id="TextAnnotation_0gcndm9">
      <bpmn:text>cancelamento com origem sistema: reembolso integral, sem multa e sem repasse (RN051, RN069)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0tek0an" associationDirection="None" sourceRef="Flow_1u8kgss" targetRef="TextAnnotation_0gcndm9" />
    <bpmn:textAnnotation id="TextAnnotation_0wgfsrb">
      <bpmn:text>motivo, descrição e até 5 imagens num envio único; depois de enviado, não se altera. O fornecedor é avisado e pode enviar a sua versão (texto e até 5 imagens), sem prazo; só a administração vê. Imagens excluídas na decisão (RN069, RF069-B).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0ile64b" associationDirection="None" sourceRef="Activity_0xd93qz" targetRef="TextAnnotation_0wgfsrb" />
    <bpmn:textAnnotation id="TextAnnotation_0928l3c">
      <bpmn:text>sem confirmação nem contestação no prazo, a conclusão é confirmada automaticamente e a carência começa a contar (RN039); a contestação encerra a tarefa e afasta essa confirmação (RN069)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0e3esdf" associationDirection="None" sourceRef="Event_0klgliw" targetRef="TextAnnotation_0928l3c" />
    <bpmn:textAnnotation id="TextAnnotation_1q5gd43">
      <bpmn:text>a avaliação é opcional: o repasse segue com ou sem ela (RN056)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0tjzxwx" associationDirection="None" sourceRef="Gateway_1o03s5g" targetRef="TextAnnotation_1q5gd43" />
  </bpmn:collaboration>
