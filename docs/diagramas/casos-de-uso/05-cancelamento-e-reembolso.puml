@startuml 05-cancelamento-e-reembolso
' Festeirinho — Diagrama de Casos de Uso 05: Cancelamento e reembolso
' Fonte: casos-de-uso.docx (UC 022, 036)
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam titleFontSize 16
skinparam usecase {
  BackgroundColor #EEEDFB
  BorderColor #534AB7
  ArrowColor #555555
}
skinparam actor {
  BorderColor #534AB7
  BackgroundColor #FFFFFF
}
skinparam rectangle {
  BorderColor #534AB7
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8E7
  BorderColor #D85A30
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #999999
  FontSize 11
}

title Diagrama de Casos de Uso — Cancelamento e reembolso

actor "Cliente" as Cliente
actor "Fornecedor" as Fornecedor
actor "Usuário" as Usuario
actor "Gateway de pagamento" as Gateway <<sistema externo>>

Usuario <|-- Cliente
Usuario <|-- Fornecedor

rectangle "Sistema Festeirinho" {
  usecase "UC 022\nSolicitar cancelamento" as UC022
  usecase "UC 036\nInformar dados de\nrecebimento do reembolso" as UC036
}

Usuario -- UC022
Cliente -- UC036
UC022 -- Gateway

UC036 .> UC022 : <<extend>>
note on link
  <b>condição:</b>
  pagamento via boleto,
  com valor de reembolso
end note

note right of UC036
  Também acionado no cancelamento automático
  (UC 019, fluxo 2a) e na contestação procedente
  (UC 043, fluxo 6a). Os dados seguem para
  validação do administrador (UC 038).
end note

@enduml
