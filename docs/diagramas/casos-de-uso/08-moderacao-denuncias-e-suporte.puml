@startuml 08-moderacao-denuncias-e-suporte
' Festeirinho — Diagrama de Casos de Uso 08: Moderação, denúncias, suporte e parâmetros
' Fonte: casos-de-uso.docx (UC 023, 026, 028, 039, 040, 041)
left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam titleFontSize 16
skinparam usecase {
  BackgroundColor #EEEDFB
  BorderColor #534AB7
  ArrowColor #555555
}
skinparam actor {
  BorderColor #534AB7
  BackgroundColor #FFFFFF
}
skinparam rectangle {
  BorderColor #534AB7
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8E7
  BorderColor #D85A30
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #999999
  FontSize 11
}

title Diagrama de Casos de Uso — Moderação, denúncias, suporte e parâmetros

actor "Cliente" as Cliente
actor "Fornecedor" as Fornecedor
actor "Usuário" as Usuario
actor "Administrador" as Admin
actor "Suporte externo\n(WhatsApp / e-mail)" as Suporte <<sistema externo>>

Usuario <|-- Cliente
Usuario <|-- Fornecedor

rectangle "Sistema Festeirinho" {
  usecase "UC 023\nDenunciar avaliação\ninadequada" as UC023
  usecase "UC 040\nDenunciar fornecedor" as UC040
  usecase "UC 039\nContatar suporte" as UC039
  usecase "UC 026\nModerar avaliação" as UC026
  usecase "UC 041\nAnalisar denúncia\nde fornecedor" as UC041
  usecase "UC 031\nSuspender fornecedor" as UC031 #FFFFFF;line.dashed;line:888888;text:666666
  usecase "UC 028\nConfigurar parâmetros\ndo sistema" as UC028
}

Fornecedor -- UC023
Cliente -- UC040
Usuario -- UC039

UC026 -- Admin
UC041 -- Admin
UC028 -- Admin
UC039 -- Suporte

UC031 .> UC041 : <<extend>>
note on link
  <b>condição:</b>
  denúncia procedente e
  suspensão cabível
end note

note right of UC026
  A denúncia de avaliação (UC 023) é
  decidida na moderação da avaliação
  (RN052, RN062).
end note

legend right
  Caso de uso tracejado: detalhado em outro
  diagrama, aparece aqui pelo relacionamento.
endlegend

@enduml
